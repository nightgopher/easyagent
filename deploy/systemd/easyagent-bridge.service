[Unit]
Description=EasyAgent Feishu bridge
Documentation=https://github.com/hwj123hwj/easyagent
BindsTo=easyagent.service
After=easyagent.service

[Service]
Type=simple
User=easyagent
Group=easyagent
WorkingDirectory=/var/lib/easyagent
EnvironmentFile=/etc/easyagent/easyagent.env
ExecStart=/usr/bin/easyagent-bridge
Restart=on-failure
RestartSec=3s

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/easyagent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# 不保留任何 capability，独立 /dev，内核日志、时钟、主机名不可改
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
