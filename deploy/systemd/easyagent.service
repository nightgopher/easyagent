[Unit]
Description=EasyAgent core server
Documentation=https://github.com/hwj123hwj/easyagent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=easyagent
Group=easyagent
WorkingDirectory=/var/lib/easyagent
EnvironmentFile=/etc/easyagent/easyagent.env
ExecStart=/usr/bin/easyagent serve
Restart=on-failure
RestartSec=3s

# 加固：文件系统只读，仅运行数据目录可写
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/easyagent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# 不保留任何 capability，独立 /dev，内核日志、时钟、主机名不可改
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true

[Install]
WantedBy=multi-user.target
